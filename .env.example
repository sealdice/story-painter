# 部署时复制为 .env.production 并按需修改，构建时自动注入（无需改源码）

# 日志数据 API 地址（store.ts 中 tryFetchLog 请求的 /load_data 接口）
# 默认: https://log-api.dice.zone/api/dice
LOG_API_BASE=https://dice-api.weizaima.com/dice/api

# RKey 获取接口地址（用于导入部分平台的日志）
# 默认: https://dice-api.weizaima.com/api/v1/rkey
RKEY_API_BASE=https://dice-api.weizaima.com/api/v1/rkey
